---
import { ViewTransitions } from "astro:transitions";
import Navbar from "./_Navbar.svelte";
import Footer from "./_Footer.svelte";
import HyperDark from "../components/HyperDark/HyperDark.svelte";
import ChromeNotification from "./_ChromeNotification.svelte";

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <title>{title}</title>

    <meta charset="UTF-8" />
    <meta name="description" content="Wei Li's Homepage built from Astronot!" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="icon" type="image/x-icon" sizes="any" href="/favicon.ico" />

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-ZXZ99MYCE4"
      is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-ZXZ99MYCE4");
    </script>

    <style is:global>
      :root {
        font-synthesis: none;
        text-rendering: optimizeLegibility;
      }

      :not(pre) > code {
        border: 1px solid #e5e7eb;
        border-radius: 0.25rem;
        background: #f3f4f6;
        color: #7f1d1d !important;
        padding: 0.08em 0.32em;
        font-size: 0.88em;
        font-weight: 500;
      }

      html.dark :not(pre) > code {
        border-color: #374151;
        background: #111827;
        color: #f9a8d4 !important;
      }

      pre code {
        border: 0;
        background: transparent;
        color: inherit !important;
        padding: 0;
      }
    </style>

    <style>
      body {
        display: flex;
        flex-direction: column;
        height: 100vh; /* Flex column with height 100vh so Footer is always on bottom, even without page content */
        margin: 0;
      }
    </style>

    <ViewTransitions />

    <script is:inline>
      const colorTheme = localStorage.getItem("color-theme");
      const isDark = colorTheme === "dark";
      document.documentElement.classList[isDark ? "add" : "remove"]("dark");

      const compactPreference = localStorage.getItem("compact");
      document.documentElement.classList.toggle(
        "compact",
        compactPreference !== "false",
      );
    </script>
  </head>

  <body
    class="align-center flex h-screen w-screen flex-col overflow-x-hidden overflow-y-scroll bg-white dark:bg-gray-900 dark:text-white"
  >
    <HyperDark client:idle />
    <Navbar client:load />

    <div class="flex-grow">
      <slot />
    </div>

    <ChromeNotification client:idle />
    <Footer client:load />
  </body>
</html>
