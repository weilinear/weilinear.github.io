---
import { twMerge } from "tailwind-merge";

const {
  headings = [],
  olClass = "leading-tight",
  aClass = "no-underline dark:text-gray-400",
} = Astro.props;

const cardClass = twMerge("toc h-fit w-full", Astro.props.cardClass);

function tableOfContents() {
  if (headings.length === 0) {
    console.warn("No Headings found");
    return "";
  }

  let toc = `<ol class='${olClass}'>`;

  let currentLevel = 1;

  for (let i = 0; i < headings.length; i++) {
    let heading = headings[i];
    let level = Number(heading.depth);

    // Adjust the indentation depending upon whether we are moving in/out/within a level
    if (level > currentLevel) {
      while (level > currentLevel) {
        toc += "<ol>";
        currentLevel++;
      }
    } else if (level < currentLevel) {
      while (level < currentLevel) {
        toc += "</ol>";
        currentLevel--;
      }
    }
    toc += `<li><a href='#${heading.slug}' class='${aClass}'>${heading.text}</a></li>`;
  }

  // If we're not back at level 1, we need to close some tags
  while (currentLevel > 1) {
    toc += "</ol>";
    currentLevel--;
  }

  toc += "</ol>";

  return toc;
}
---

<nav class={cardClass} aria-label="Table of contents">
  <span class="toc-title">On this page</span>
  <div set:html={tableOfContents()} />
</nav>

<style>
  .toc {
    border-left: 1px solid rgb(209 213 219);
    padding-left: 1rem;
  }

  :global(.dark) .toc {
    border-color: rgb(55 65 81);
  }

  .toc-title {
    display: block;
    margin-bottom: 0.75rem;
    color: rgb(107 114 128);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .toc :global(ol) {
    margin: 0;
    padding-left: 1rem;
  }

  .toc :global(li) {
    margin: 0.42rem 0;
    color: rgb(156 163 175);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .toc :global(a) {
    color: rgb(75 85 99);
    text-decoration: none;
  }

  .toc :global(a:hover) {
    color: rgb(37 99 235);
  }

  :global(.dark) .toc :global(a) {
    color: rgb(156 163 175);
  }

  :global(.dark) .toc :global(a:hover) {
    color: rgb(147 197 253);
  }
</style>
