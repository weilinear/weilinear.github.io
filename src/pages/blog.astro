---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Tags from "../components/Tags.astro";
import TagsFilter from "../components/TagsFilter.svelte";
import { postImageImport } from "../helpers/images.mjs";
import { Alert } from "flowbite-svelte";
import { PenSolid } from "flowbite-svelte-icons";

const POSTS_PATH = "posts";
const COVER_IMG_ASPECT_RATIO = "13/9"; // TODO: Expose as variable

const {
  showTagsFilter = true,
  showProfile = false,
  showOnlyTag = null,
} = Astro.props;

const posts = await Astro.glob("./posts/*.mdx");

const seenTags = {};
const tagsList = posts.reduce((acc, post) => {
  const postTags = post?.frontmatter?.tags;

  if (postTags) {
    postTags.forEach((tag) => {
      const id = tag.id;

      if (!seenTags[id]) {
        seenTags[id] = true;
        acc.push(tag);
      }
    });
  }

  return acc;
}, []);
---

<style is:global>
  html.compact .post-cover-image {
    display: none !important;
  }

  html.compact .blog-shell {
    max-width: 72rem !important;
    padding-top: 2rem !important;
  }

  html.compact .blog-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 0 0 1.25rem !important;
    max-width: none !important;
    text-align: left !important;
  }

  html.compact .blog-header h1 {
    margin: 0 !important;
    font-size: 1.8rem !important;
    letter-spacing: -0.025em !important;
  }

  html.compact .blog-subheading {
    margin-top: 0.3rem;
    font-size: 0.92rem !important;
  }

  html.compact .blog-filter {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem;
    margin: 0 0 1rem;
  }

  html.compact .blog-filter-label {
    color: #6b7280;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  html.compact .blog-filter > div > svg {
    display: none;
  }

  html.compact #tags-select-container {
    width: 12rem !important;
  }

  html.compact #tags-select-container button {
    min-height: 2.25rem !important;
    padding-top: 0.3rem !important;
    padding-bottom: 0.3rem !important;
  }

  html.compact #tags-select-container [role="listbox"] > span:empty::before {
    content: "All topics";
    color: #6b7280;
    font-size: 0.78rem;
  }

  html.dark.compact
    #tags-select-container
    [role="listbox"]
    > span:empty::before {
    color: #9ca3af;
  }

  html.compact .post-list {
    display: flex;
    flex-direction: column;
    align-items: stretch !important;
    gap: 0;
    width: 100%;
    margin-top: 0 !important;
    border-top: 1px solid #d1d5db;
  }

  html.dark.compact .post-list {
    border-color: #374151;
  }

  html.compact .post-link-container {
    display: block;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }

  html.compact .post-link-container.hidden {
    display: none !important;
  }

  html.compact .post-article {
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: 1px solid #e5e7eb;
    border-radius: 0;
    box-shadow: none;
    background: transparent !important;
    transition: background-color 120ms ease;
  }

  html.dark.compact .post-article {
    border-color: #1f2937;
  }

  html.compact .post-article:hover {
    transform: none;
    background-color: #f9fafb !important;
  }

  html.dark.compact .post-article:hover {
    background-color: #111827 !important;
  }

  html.compact .post-card-body {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 1.25rem;
    min-height: 4.25rem;
    padding: 0.72rem 0.8rem;
  }

  html.compact .post-meta {
    display: contents;
  }

  html.compact .post-date-group {
    display: contents;
  }

  html.compact .post-date {
    grid-column: 1;
    grid-row: 1 / span 2;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    font-size: 0.76rem;
    letter-spacing: 0.015em;
    color: #6b7280;
    white-space: nowrap;
  }

  html.dark.compact .post-date {
    color: #9ca3af;
  }

  html.compact .post-meta-separator {
    display: none !important;
  }

  html.compact .post-reading-time {
    grid-column: 3;
    grid-row: 1 / span 2;
    color: #9ca3af;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      monospace;
    font-size: 0.72rem;
    white-space: nowrap;
  }

  html.compact .post-article h2 {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    color: #111827;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  html.dark.compact .post-article h2 {
    color: #f3f4f6 !important;
  }

  html.compact .post-link-container:hover h2 {
    color: #2563eb;
  }

  html.dark.compact .post-link-container:hover h2 {
    color: #93c5fd !important;
  }

  html.compact .post-tags {
    grid-column: 2;
    grid-row: 2;
    margin-top: 0.28rem;
    opacity: 0.68;
  }

  html.compact .post-tags > div {
    margin-bottom: 0 !important;
  }

  html.compact .post-description {
    display: none;
  }

  html.compact .post-profile {
    display: none;
  }

  @media (max-width: 639px) {
    html.compact .blog-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }

    html.compact .blog-filter,
    html.compact #tags-select-container {
      width: 100% !important;
    }

    html.compact .blog-filter {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.4rem;
    }

    html.compact .blog-filter div.flex {
      justify-content: flex-start;
      width: 100%;
    }

    html.compact .post-card-body {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 0.75rem;
      padding: 0.85rem 0.2rem;
    }

    html.compact .post-article h2 {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    html.compact .post-date {
      grid-column: 1;
      grid-row: 2;
      margin-top: 0.4rem;
    }

    html.compact .post-reading-time {
      grid-column: 2;
      grid-row: 2;
      margin-top: 0.4rem;
    }

    html.compact .post-tags {
      display: none;
    }
  }
</style>

<Layout title="Blog">
  <main class="">
    <section class="">
      <div
        class="blog-shell mx-auto max-w-screen-2xl px-4 py-8 lg:px-6 lg:py-16"
      >
        <div
          class="blog-header mx-auto mb-4 max-w-screen-sm text-center lg:mb-8"
        >
          <div>
            <h1
              class="mb-4 text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white lg:text-5xl"
            >
              Blog
            </h1>
            <h2
              class="blog-subheading font-light text-gray-500 dark:text-gray-400 max-[375px]:text-xs sm:text-xl lg:text-2xl"
            >
              Articles, tutorials, videos, musings, and more
            </h2>
          </div>
        </div>

        {
          showTagsFilter && showOnlyTag == null && tagsList.length > 1 && (
            <div class="blog-filter">
              <>
                <span class="blog-filter-label">Filter</span>
                <TagsFilter tagsList={tagsList} client:load />
              </>
            </div>
          )
        }

        <div
          class="post-list mt-8 grid items-center gap-8 md:grid-cols-2 lg:mt-16 xl:grid-cols-3"
        >
          {
            posts
              .sort((postA, postB) => {
                const aDate = new Date(postA.frontmatter.publish_date);
                const bDate = new Date(postB.frontmatter.publish_date);
                return bDate.getTime() - aDate.getTime();
              })
              .map(async (post) => {
                const { cover, title } = post?.frontmatter;
                const dateStr = new Date(
                  post.frontmatter.publish_date,
                ).toLocaleString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                });

                let optimizedCoverImage: any = null;
                let coverImageSrc: string = "";
                let preloadCoverImageSrc: string = "";
                let preloadCoverImageMobileSrc: string = "";

                if (cover) {
                  const imageFilePath = (await postImageImport(cover)).default;

                  optimizedCoverImage = await getImage({
                    src: imageFilePath,
                    width: 1400,
                  });

                  coverImageSrc = (
                    await getImage({
                      src: imageFilePath,
                      width: 1400,
                    })
                  ).src;

                  preloadCoverImageSrc = (
                    await getImage({
                      src: imageFilePath,
                      width: 1920,
                      height: 1080,
                    })
                  ).src;

                  preloadCoverImageMobileSrc = (
                    await getImage({
                      src: imageFilePath,
                      width: 720,
                      height: 480,
                    })
                  ).src;

                  coverImageSrc = (optimizedCoverImage as any).src;
                }

                return (
                  <a
                    href={`/${POSTS_PATH}/${post.frontmatter.slug}`}
                    class={
                      "post-link-container contents " +
                      post.frontmatter.tags
                        .map((tag) => `post-link-tag-${tag.id}`)
                        .join(" ")
                    }
                  >
                    <article class="post-article h-fit transform rounded-lg border border-gray-200 bg-white shadow-md transition duration-100 ease-in dark:border-gray-700 dark:bg-gray-800 sm:hover:scale-[102%] lg:hover:scale-105">
                      <div
                        class="post-cover-image"
                        style={`view-transition-name: cover-image-${post.frontmatter.id};`}
                      >
                        {post.frontmatter.status !== "published" && (
                          <Alert color="yellow">
                            <PenSolid slot="icon" class="h-4 w-4" />
                            Edit this <span class="font-extrabold">
                              draft
                            </span>{" "}
                            post in{" "}
                            <a
                              href="notion.so"
                              target="blank"
                              class="font-semibold"
                            >
                              Notion
                            </a>
                          </Alert>
                        )}

                        {cover && (
                          <>
                            <img
                              class={`mb-1 h-auto w-full rounded-md rounded-b-none object-cover`}
                              style={`aspect-ratio: ${COVER_IMG_ASPECT_RATIO}`}
                              src={coverImageSrc}
                              alt="cover"
                            />

                            <link
                              rel="prefetch"
                              href={preloadCoverImageSrc}
                              as="image"
                            />

                            <link
                              rel="prefetch"
                              href={preloadCoverImageMobileSrc}
                              as="image"
                            />
                          </>
                        )}
                      </div>
                      <div
                        class="post-card-body p-4"
                        style={`view-transition-name: cover-title-${post.frontmatter.id};`}
                      >
                        <div class="post-tags">
                          <Tags tags={post.frontmatter.tags} />
                        </div>

                        <h2 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                          {post.frontmatter.title}
                        </h2>

                        <p
                          class="post-description mb-4 whitespace-pre-line font-light text-gray-500 dark:text-gray-400"
                          set:html={
                            post.frontmatter.description !== "undefined"
                              ? post.frontmatter.description
                              : ""
                          }
                        />

                        {/* Author Section */}
                        {showProfile ? (
                          <div class="post-profile flex items-center space-x-3">
                            <img
                              class="h-11 w-11 rounded-full"
                              src="/images/portrait.webp"
                              alt="Buzz's avatar"
                            />
                            <div class="font-medium dark:text-white">
                              <div>Fizzbuzz Aldrin</div>
                              <div class="post-meta text-sm font-normal text-gray-500 dark:text-gray-400">
                                <span
                                  class:list={[
                                    "post-date-group",
                                    !post.frontmatter.publish_date && "hidden",
                                  ]}
                                >
                                  <span class="post-date">{dateStr}</span>
                                  <span class="post-meta-separator"> · </span>
                                </span>
                                <span class="post-reading-time">
                                  {post.frontmatter.reading_time}
                                </span>
                              </div>
                            </div>
                          </div>
                        ) : (
                          <div class="post-meta text-sm font-normal text-gray-500 dark:text-gray-400">
                            <span
                              class:list={[
                                "post-date-group",
                                !post.frontmatter.publish_date && "hidden",
                              ]}
                            >
                              <span class="post-date">{dateStr}</span>
                              <span class="post-meta-separator"> · </span>
                            </span>
                            <span class="post-reading-time">
                              {post.frontmatter.reading_time}
                            </span>
                          </div>
                        )}
                      </div>
                    </article>
                  </a>
                );
              })
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
